{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aimx-recipes:schema:2.0.0:validation-result",
  "title": "Validation Result Schema",
  "type": "object",
  "required": [
    "result_version",
    "level",
    "status",
    "structurally_valid",
    "contextual_complete",
    "diagnostics"
  ],
  "properties": {
    "result_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "level": {
      "type": "string",
      "enum": ["structural", "contextual"]
    },
    "status": {
      "type": "string",
      "enum": ["valid", "invalid", "incomplete"]
    },
    "structurally_valid": {
      "type": "boolean"
    },
    "contextual_complete": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_type",
          "record_id",
          "input_index",
          "pointer",
          "code",
          "message",
          "check",
          "severity"
        ],
        "properties": {
          "entity_type": {
            "type": ["string", "null"]
          },
          "record_id": {
            "type": ["string", "null"]
          },
          "input_index": {
            "type": "integer",
            "minimum": 0
          },
          "pointer": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["error", "incomplete"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
