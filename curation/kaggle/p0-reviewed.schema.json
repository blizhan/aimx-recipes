{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P0ReviewedList",
  "description": "Schema for curated P0 reviewed competitions list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "competition_id",
          "slug",
          "decision",
          "reason",
          "reviewed_by",
          "reviewed_on"
        ],
        "properties": {
          "competition_id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "enum": ["include", "exclude"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reviewed_by": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reviewed_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  }
}
